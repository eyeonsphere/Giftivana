# Copy to .env.local — never commit real values.

# ---- Supabase (Stage 3) ----
# Public: safe in the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never import where a client bundle can reach it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Payments (Stage 4) ----
# Enables the clearly-labelled demo payment provider. Ignored when NODE_ENV=production.
PAYMENTS_DEMO_ENABLED=true

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
